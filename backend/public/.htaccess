# BEGIN pibls
# =====================================================================================================================
# .htaccess do docroot (public_html/ e homolog_html/). Fonte: architecture.md → Infrastructure → `.htaccess` de
# public_html e contracts/web-routes.md.
#
# Este arquivo é MESCLADO pelo ativador (finalize.php): a cada release, só o bloco delimitado pelas linhas BEGIN e END
# deste arquivo é substituído. O que o cPanel escreve fora dele (handler do PHP, proteção por senha da homologação) é
# preservado. Por isso: não edite o .htaccess do servidor à mão dentro do bloco; mude este arquivo e faça um deploy.
# (As linhas de marcação precisam ficar sozinhas na linha e aparecer uma única vez: nunca as cite em comentários.)
#
# Ordem de resolução (a ordem das regras abaixo é a ordem do contrato):
#   1. Índice, listagem de diretório, HTTPS e www
#   2. Arquivos sensíveis negados
#   3. Redirecionamentos 301 do WordPress (mapa do cutover)
#   4. Arquivo existente → servido direto (assets/, data/, uploads/…)
#   5. <caminho>.html existente → servido (páginas pré-renderizadas)
#   6. /api, /sanctum, /eventos/<slug>, /palavra-viva/<slug>, /sitemap.xml → index.php (Laravel)
#   7. Qualquer outro caminho → __spa-fallback.html (painel e 404 da SPA)
#   8. Cabeçalhos de segurança e de cache
# =====================================================================================================================

# 1. Índice e listagem de diretório
DirectoryIndex index.html
Options -Indexes

<IfModule mod_rewrite.c>
    RewriteEngine On

    # HTTP → HTTPS e www → sem www, num redirecionamento só (301)
    RewriteCond %{HTTP_HOST} ^www\.(.+)$ [NC]
    RewriteRule ^ https://%1%{REQUEST_URI} [L,R=301]


    # 2. Arquivos sensíveis: qualquer arquivo ou pasta que comece com ponto (menos .well-known, do AutoSSL),
    #    composer.json/lock e dumps/logs. O .env mora fora do docroot; isto é uma segunda barreira.
    RewriteRule (^|/)\.(?!well-known(/|$)) - [F,L]
    RewriteRule (^|/)composer\.(json|lock)$ - [F,L]
    RewriteRule \.(sql|log)$ - [F,L]

    # 3. Redirecionamentos 301 do WordPress (G-01, T158). O mapa do cutover entra aqui, uma regra por URL antiga.
    #    Exemplo (não ativo):
    #    RewriteRule ^conheca-a-igreja/?$ /quem-somos [R=301,L]

    # 4. A raiz (/) fica com o DirectoryIndex (index.html); arquivo existente (assets/, data/, uploads/, favicon…) é
    #    servido direto, sem passar por regra nenhuma
    RewriteRule ^$ - [L]

    RewriteCond %{REQUEST_FILENAME} -f
    RewriteRule ^ - [L]

    # 5. Página pré-renderizada: /quem-somos → quem-somos.html (com ou sem barra final)
    RewriteCond %{DOCUMENT_ROOT}/$1.html -f
    RewriteRule ^(.+?)/?$ $1.html [L]

    # 6. Rotas do Laravel: API, cookie CSRF, páginas com meta tags injetadas, sitemap e a documentação da API
    #    (esta só responde em local e homologação; em produção o Laravel devolve 404)
    RewriteRule ^(api|sanctum)/ index.php [L]
    RewriteRule ^eventos/[a-z0-9-]+/?$ index.php [L]
    RewriteRule ^palavra-viva/[a-z0-9-]+/?$ index.php [L]
    RewriteRule ^sitemap\.xml$ index.php [L]
    RewriteRule ^docs/api(\.json)?$ index.php [L]

    # 7. Todo o resto é a SPA: rotas do painel e a página 404 amigável
    RewriteRule ^ __spa-fallback.html [L]
</IfModule>

# 8a. Cabeçalhos de segurança, em todas as respostas (inclusive erros)
<IfModule mod_headers.c>
    Header always set X-Content-Type-Options "nosniff"
    Header always set Referrer-Policy "strict-origin-when-cross-origin"
    Header always set Permissions-Policy "camera=(), microphone=(), geolocation=(), payment=()"
    Header always set X-Frame-Options "DENY"
    # 'unsafe-inline' em script-src é débito técnico aceito: o HTML pré-renderizado do React Router traz scripts
    # inline de hidratação (Security → CSRF, XSS; Technical Debt Accepted).
    Header always set Content-Security-Policy "default-src 'self'; script-src 'self' 'unsafe-inline' https://gc.zgo.at; style-src 'self' 'unsafe-inline'; img-src 'self' data: https://i.ytimg.com; frame-src https://www.youtube-nocookie.com https://www.google.com; connect-src 'self' https://*.sentry.io https://*.goatcounter.com; font-src 'self'; object-src 'none'; base-uri 'self'; form-action 'self'; frame-ancestors 'none'"

    # O painel e a API não são indexados. THE_REQUEST guarda a URL original: REQUEST_URI já vira `/index.php` ou
    # `/__spa-fallback.html` depois do rewrite interno.
    <If "%{THE_REQUEST} =~ m#^[A-Z]+ /(admin|api)([/?\s]|$)#">
        Header always set X-Robots-Tag "noindex"
    </If>

    # Homologação inteira fora dos buscadores (ADR-017)
    <If "%{HTTP_HOST} == 'homolog.pibls.com'">
        Header always set X-Robots-Tag "noindex, nofollow"
    </If>

    # 8b. Cache por tipo (Performance → Estratégia). `set` só nos arquivos estáticos: as respostas do Laravel
    #     (API, páginas com meta) definem o próprio Cache-Control.
    <If "%{REQUEST_URI} =~ m#^/assets/#">
        Header set Cache-Control "public, max-age=31536000, immutable"
    </If>
    <ElseIf "%{REQUEST_URI} =~ m#^/(uploads|images|logos)/#">
        Header set Cache-Control "public, max-age=2592000"
    </ElseIf>
    <ElseIf "%{REQUEST_URI} =~ m#^/data/.+\.json$#">
        Header set Cache-Control "no-cache"
    </ElseIf>
    <FilesMatch "\.html$">
        Header set Cache-Control "no-cache"
    </FilesMatch>
</IfModule>

# 8c. Compressão de texto, se o módulo existir na conta
<IfModule mod_deflate.c>
    AddOutputFilterByType DEFLATE text/html text/plain text/css text/xml application/javascript application/json application/xml image/svg+xml
</IfModule>

<IfModule mod_mime.c>
    AddType image/webp .webp
    AddType application/manifest+json .webmanifest
</IfModule>
# END pibls
