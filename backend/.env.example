APP_NAME=PIBLS
APP_ENV=local
APP_KEY=
APP_DEBUG=true
APP_URL=http://localhost:8080

APP_LOCALE=pt_BR
APP_FALLBACK_LOCALE=pt_BR
APP_FAKER_LOCALE=pt_BR

APP_MAINTENANCE_DRIVER=file

BCRYPT_ROUNDS=12

LOG_CHANNEL=stack
LOG_STACK=daily
LOG_DEPRECATIONS_CHANNEL=null
LOG_LEVEL=debug

# Docker Compose local (serviço "mysql"). Fora do Docker, use 127.0.0.1.
DB_CONNECTION=mysql
DB_HOST=mysql
DB_PORT=3306
DB_DATABASE=pibls
DB_USERNAME=pibls_app
DB_PASSWORD=secret

SESSION_DRIVER=database
SESSION_LIFETIME=60
SESSION_ENCRYPT=false
SESSION_PATH=/
SESSION_DOMAIN=null
HIBP_ENABLED=true

FILESYSTEM_DISK=local
QUEUE_CONNECTION=database
CACHE_STORE=database

# Mailpit local (interface em http://localhost:8025). E-mail só pela fila.
MAIL_MAILER=smtp
MAIL_SCHEME=null
MAIL_HOST=mailpit
MAIL_PORT=1025
MAIL_USERNAME=null
MAIL_PASSWORD=null
MAIL_FROM_ADDRESS="portal@pibls.test"
MAIL_FROM_NAME="${APP_NAME}"

# Documentação da API em /docs/api (Scramble): só local e homologação
API_DOCS_ENABLED=true

# Feature flags (R2): eventos desligados no R1
FEATURE_EVENTS=false

# Privacidade e retenção (docs: Data Privacy Strategy). Os prazos podem mudar sem novo código.
PRIVACY_POLICY_VERSION=1.0
RETENTION_ORACAO_DAYS=60
RETENTION_ORACAO_UNFINISHED_DAYS=90
RETENTION_LEADS_MONTHS=12
RETENTION_REGISTRATIONS_MONTHS=3
RETENTION_AUDIT_MONTHS=24
FAILED_JOBS_RETENTION_DAYS=30

# Alerta de alteração do PIX (BR-063): fora do painel, de propósito. Vários e-mails separados por vírgula.
PIX_ALERT_RECIPIENTS=

# Homologação: só estes endereços recebem e-mail de verdade. Vazio = sem restrição.
MAIL_ALLOWLIST=

# Usuários de teste do LocalDevelopmentSeeder (`php artisan db:seed`). Só local e CI.
TEST_USERS_PASSWORD=senha-local-123

# Observabilidade. Vazio = desligado (local e CI).
SENTRY_LARAVEL_DSN=
HEALTHCHECKS_PING_URL=
HEALTHCHECKS_BACKUP_DB_URL=
HEALTHCHECKS_BACKUP_OFFSITE_URL=
HEALTHCHECKS_PURGE_URL=
HEALTHCHECKS_MAIL_URL=

# Backup (ADR-011, I-09). `php artisan pibls:backup:keygen` (na SUA máquina) gera o par; só a pública vai para o servidor.
# Só a produção faz backup e cópia ao B2; local e homologação ficam em false
BACKUPS_ENABLED=false
BACKUP_PUBLIC_KEY=
B2_KEY_ID=
B2_APPLICATION_KEY=
B2_BUCKET=
B2_REGION=eu-central-003
B2_ENDPOINT=https://s3.eu-central-003.backblazeb2.com

# Resumo diário por e-mail às 07:00 (vários endereços separados por vírgula) e métricas do dia 1
DAILY_REPORT_RECIPIENTS=
GO_LIVE_DATE=
UPTIMEROBOT_API_KEY=

# Em produção/homologação: usuário com DDL, usado só pelo ativador (`migrate --database=migrator`).
# Sem estas variáveis vale DB_USERNAME (local e CI).
# DB_MIGRATOR_USERNAME=
# DB_MIGRATOR_PASSWORD=

# Em produção/homologação, fora das releases (o deploy nunca toca nestas pastas).
# UPLOADS_PATH=/home/USUARIO/public_html/uploads
# SNAPSHOTS_PATH=/home/USUARIO/public_html/data
