# =============================================================================
# .env de PRODUÇÃO e HOMOLOGAÇÃO (modelo). Fonte: architecture.md → DevOps → Injeção de segredos.
#
# Crie à mão, UMA vez, em /home/USUARIO/private/<app>/shared/.env (<app> = pibls
# ou pibls-homolog) com permissão 600. O CI nunca conhece estes valores: o pacote
# de release não leva .env (o gerador de pacote recusa se houver).
#
# Os campos marcados com ⚠ precisam ser preenchidos; o `pibls:doctor` confere.
# =============================================================================

# --- Aplicação ---------------------------------------------------------------
APP_NAME=PIBLS
# Homologação também usa "production": é o mesmo servidor, com o mesmo comportamento.
APP_ENV=production
# ⚠ Gere uma chave por ambiente: no seu computador, `php artisan key:generate --show`.
# Guarde uma cópia no kit de contingência: sem ela, os campos cifrados não abrem.
APP_KEY=
APP_DEBUG=false
# ⚠ https://pibls.com   |   homologação: https://homolog.pibls.com
APP_URL=https://pibls.com

APP_LOCALE=pt_BR
APP_FALLBACK_LOCALE=pt_BR
APP_FAKER_LOCALE=pt_BR
APP_MAINTENANCE_DRIVER=file
BCRYPT_ROUNDS=12

# --- Logs (JSON, 14 dias, em shared/storage/logs/app-AAAA-MM-DD.log) ----------
LOG_CHANNEL=stack
LOG_STACK=daily
LOG_LEVEL=info
LOG_DEPRECATIONS_CHANNEL=null

# --- Banco (MySQL local da conta) --------------------------------------------
DB_CONNECTION=mysql
DB_HOST=localhost
DB_PORT=3306
# ⚠ Um banco por ambiente: pibls_prod  |  pibls_homolog (com o prefixo da conta no cPanel)
DB_DATABASE=
# ⚠ pibls_app: só DML (SELECT, INSERT, UPDATE, DELETE). Usado pela web e pelo agendador.
DB_USERNAME=
DB_PASSWORD=
# ⚠ pibls_migrator: DDL + DML. Usado SÓ pelo ativador (migrate --database=migrator).
DB_MIGRATOR_USERNAME=
DB_MIGRATOR_PASSWORD=

# --- Sessão, fila e cache (tudo no MySQL; sem Redis na hospedagem) -----------
SESSION_DRIVER=database
SESSION_LIFETIME=60
SESSION_ENCRYPT=false
SESSION_PATH=/
SESSION_DOMAIN=null
SESSION_SECURE_COOKIE=true
# Senhas vazadas (Have I Been Pwned, k-anonimato; fail-open se a API cair). Deixe ligado.
HIBP_ENABLED=true
QUEUE_CONNECTION=database
CACHE_STORE=database
CACHE_LIMITER_STORE=database
FILESYSTEM_DISK=local

# --- E-mail (SMTP da conta, porta 465 com TLS). E-mail só pela fila. ----------
MAIL_MAILER=smtp
MAIL_SCHEME=smtps
# ⚠ Servidor SMTP da conta (cPanel → "Configurar cliente de e-mail")
MAIL_HOST=
MAIL_PORT=465
MAIL_USERNAME=
MAIL_PASSWORD=
# ⚠ Caixa existente na conta, no domínio da igreja (o DNS de e-mail não é alterado)
MAIL_FROM_ADDRESS=
MAIL_FROM_NAME="${APP_NAME}"
# Homologação: só estes endereços (separados por vírgula) recebem e-mail de verdade.
# Em produção, deixe vazio.
MAIL_ALLOWLIST=

# --- Pastas públicas (fora das releases: o deploy nunca toca nelas) -----------
# ⚠ public_html/uploads  |  homolog_html/uploads
UPLOADS_PATH=/home/USUARIO/public_html/uploads
# ⚠ public_html/data  |  homolog_html/data  (snapshots JSON servidos pelo Apache)
SNAPSHOTS_PATH=/home/USUARIO/public_html/data
# ⚠ public_html/__spa-fallback.html  |  homolog_html/__spa-fallback.html  (HTML da SPA em que o Laravel injeta a meta de /palavra-viva/{slug})
SPA_FALLBACK_PATH=/home/USUARIO/public_html/__spa-fallback.html

# --- Regras do negócio -------------------------------------------------------
# R1 sai com os eventos desligados. Ligue (true) só depois do teste de concorrência de vagas.
FEATURE_EVENTS=false
# Versão vigente da Política de Privacidade, gravada em cada consentimento (BR-082)
PRIVACY_POLICY_VERSION=1.0
# ⚠ Alerta de alteração do PIX (BR-063): e-mails da Tesouraria e da liderança, separados por vírgula.
# Fica FORA do painel, de propósito. Sem isso, nenhuma alteração do PIX é aceita.
PIX_ALERT_RECIPIENTS=

# Retenção de dados pessoais (Data Privacy Strategy). Prazos aprovados pela liderança em 2026-10-23 (TBD-03).
RETENTION_ORACAO_DAYS=60
RETENTION_ORACAO_UNFINISHED_DAYS=90
RETENTION_LEADS_MONTHS=12
RETENTION_REGISTRATIONS_MONTHS=3
RETENTION_AUDIT_MONTHS=24
FAILED_JOBS_RETENTION_DAYS=30

# --- Observabilidade ---------------------------------------------------------
# Sentry (UE): DSN do projeto do backend. Vazio = desligado.
SENTRY_LARAVEL_DSN=
SENTRY_ENVIRONMENT=production
# Healthchecks.io (I-08): um check por tarefa; o ping sai do próprio comando. Vazio = sem ping.
HEALTHCHECKS_PING_URL=
FINALIZE_PING_URL=
HEALTHCHECKS_BACKUP_DB_URL=
HEALTHCHECKS_BACKUP_OFFSITE_URL=
HEALTHCHECKS_PURGE_URL=
HEALTHCHECKS_MAIL_URL=
# Mais que isto de e-mails com falha definitiva em 1 h dispara o alerta de falhas de e-mail
# MAIL_FAILURE_THRESHOLD=10
# Onde o resumo diário lê os logs JSON (padrão: storage/logs do ambiente)
# PIBLS_LOGS_PATH=

# --- Backup (ADR-011, I-09) --------------------------------------------------
# Rode `php artisan pibls:backup:keygen` na SUA máquina: a chave pública vai aqui; a PRIVADA, só no KeePassXC do kit de
# contingência, nunca no servidor. Sem BACKUP_PUBLIC_KEY o dump não é gerado (nunca em texto claro).
# Produção: true. HOMOLOGAÇÃO: false (não gera backup nem manda cópia ao B2 de produção).
BACKUPS_ENABLED=true
BACKUP_PUBLIC_KEY=
# Pasta dos dumps cifrados (padrão: storage/backups do ambiente); o disco S3 da cópia externa é o `b2`
# BACKUPS_PATH=
# BACKUP_OFFSITE_DISK=b2
# Backblaze B2: chave de aplicação restrita ao bucket e SEM permissão de exclusão
B2_KEY_ID=
B2_APPLICATION_KEY=
B2_BUCKET=
B2_REGION=eu-central-003
B2_ENDPOINT=https://s3.eu-central-003.backblazeb2.com

# Resumo diário por e-mail às 07:00 (vários endereços separados por vírgula); o do dia 1 traz as métricas do mês
DAILY_REPORT_RECIPIENTS=
# Data do go-live (AAAA-MM-DD): as semanas do SC-006 contam daí
GO_LIVE_DATE=
# Chave SÓ DE LEITURA do UptimeRobot, para a disponibilidade do mês
UPTIMEROBOT_API_KEY=

# --- Documentação da API (Scramble, em /docs/api) -----------------------------
# false em produção; true só na homologação.
API_DOCS_ENABLED=false
